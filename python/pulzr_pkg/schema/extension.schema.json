{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pulzar-net/pulzr-protocol/schema/extension.schema.json",
  "title": "Pulzar extension modules (EXTENSIONS.md)",
  "$defs": {
    "module": {
      "description": "A WebAssembly module the platform runs in its sandbox (EXTENSIONS.md). Each extension kind's manifest holds one, and may add keys of its own.",
      "type": "object",
      "required": ["runtime", "module", "sha256"],
      "properties": {
        "runtime": { "const": "wasm" },
        "module": { "description": "The release asset holding the module.", "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.wasm$" },
        "sha256": { "description": "The module's SHA-256, lower-case hex.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "limits": {
          "type": "object",
          "properties": {
            "fuel": { "type": "integer", "minimum": 100000, "maximum": 1000000000 },
            "memoryMiB": { "type": "integer", "minimum": 1, "maximum": 256 },
            "stateKiB": { "type": "integer", "minimum": 1, "maximum": 1024 }
          },
          "additionalProperties": false
        },
        "imports": {
          "description": "The host functions the module may import (module pz).",
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["log", "now", "state", "http"] }
        },
        "http": {
          "type": "object", "required": ["hosts"],
          "properties": {
            "hosts": { "type": "array", "minItems": 1, "uniqueItems": true,
                       "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" } }
          },
          "additionalProperties": false
        },
        "credentials": {
          "description": "A JSON Schema object of the fields an admin fills in when installing the module: its property names are what requests name as {{credential.<name>}}; a property with writeOnly or format password is secret.",
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": { "const": "object" },
            "properties": { "type": "object", "propertyNames": { "pattern": "^[a-z_][a-z0-9_]{0,63}$" } }
          }
        }
      },
      "dependentRequired": { "http": ["imports"] }
    }
  }
}
